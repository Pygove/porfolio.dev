---
import ExperienceItem from "../components/ExperienceItem.astro"
const EXPERIENCIE = [
  {
    date: "Agosto 2024 - Noviembre 2024",
    title: "Práctica profesional como Analista de datos",
    description:
      "Realicé un análisis exhaustivo de las necesidades de la organización, desarrollando indicadores clave de desempeño (KPIs) significativos que facilitan la toma de decisiones estratégicas. \nCompleté con éxito un proceso integral de limpieza y transformación de los datos proporcionados por la ONG, utilizando fórmulas avanzadas en Google Sheets y replicando el proceso en Power BI con fines experimentales. \nElaboré un informe detallado en Looker Studio, incorporando los KPIs requeridos y una variedad de gráficos que optimizan la visualización y el análisis de los datos previamente sin procesar.",
  },
  {
    date: "Julio 2019 - Diciembre 2023",
    title: "Python Developer",
    description:
      "Desarrollé un programa en Python que obtiene como resultado datos específicos, como tensiones, deformaciones y desplazamientos, producidos en el estado de rotura de una mampostería sometida a compresión. \nUn reto clave en este proyecto fue la comunicación y coordinación entre el área de programación, conformada únicamente por mí, y los estudiantes/ingenieros del área de civil. Me encargué de traducir conceptos complejos en un programa con el objetivo de automatizar el proceso experimental.",
  },
]
---

<ol class="relative mt-16">
  {
    EXPERIENCIE.map((experiencie) => (
      <li class="">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>